      },
      {
        "key": "shift+cmd+v",
        "command": "bettermd.insertFile",
        "when": "activeCustomEditorId == 'bettermd.editor' && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !inQuickOpen && !notificationFocus"
      }
    ],
    "configuration": {
      "title": "BetterMD",
      "properties": {
        "bettermd.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "打字停下来一会儿就自动保存，和 BetterMD App 一样。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/lib.test.js"
  }
}
